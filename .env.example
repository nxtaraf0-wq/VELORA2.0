# VELORA Environment Configuration

# Server Environment
PORT=3000
NODE_ENV=production
APP_BASE_URL="http://localhost:3000"

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="velora_db"

# JWT Secret for Customer & Admin Authentication
JWT_SECRET="velora_super_secure_jwt_secret_change_in_production_key_2026"

# Admin Bootstrap Setup Secret (Used for the one-time secure initial admin creation)
ADMIN_SETUP_SECRET="velora_bootstrap_setup_token_987654"
